!**/.vscode/extensions.json
!**/.vscode/tasks.json

**/.idea/**
!**/.idea/.gitignore
!**/.idea/codeStyles/**
!**/.idea/inspectionProfiles/**
!**/.idea/runConfigurations/**
!**/.idea/modules.xml
!**/.idea/misc.xml
!**.iml


**/out/production**
!**/out/production/.gitkeep
**/*.class
**/__pycache__**



